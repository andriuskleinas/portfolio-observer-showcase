# Copy to .env and adjust. .env is git-ignored.

# Reporting currency for all totals and returns (D1)
PT_BASE_CURRENCY=USD

# Where the database, documents and backups live. Defaults to ./data
# PT_DATA_DIR=/absolute/path/to/data

# Interactive Brokers Flex Web Service (DASH-17, v1) — keep these secret
# PT_IBKR_FLEX_TOKEN=
# PT_IBKR_FLEX_QUERY_ID=
